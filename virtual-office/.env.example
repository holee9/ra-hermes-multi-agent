# Human→RA advisory channel (#104) — copy to .env and fill values.
# .env is gitignored; never commit real keys.

# Hermes API server Bearer key (same value as scripts/.env API_SERVER_KEY).
API_SERVER_KEY=

# Single-user client auth token for POST /api/chat (OD-2). Empty = LAN-only POC bypass.
# Generate a uuid: cat /proc/sys/kernel/random/uuid
CHAT_AUTH_TOKEN=

# Hermes API URL from the adapter container's viewpoint (host runs Hermes on :8643).
HERMES_API_URL=http://192.168.100.200:8643
